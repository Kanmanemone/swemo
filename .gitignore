# Gradle / Kotlin build outputs
.gradle/
.gradle-user-home/
.kotlin/
build/
captures/
.externalNativeBuild/
.cxx/

# Local configuration (SDK path, etc.)
local.properties

# Packaging / profiling artifacts
*.apk
*.aab
*.ap_
*.dex
output-metadata.json
*.hprof

# Signing keys, secrets & service configs - never commit these
*.jks
*.keystore
google-services.json
*.env
*.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
*.swp
*~
# IntelliJ / Android Studio: re-importable from settings.gradle.kts, keep only code styles
*.iml
.idea/*
!/.idea/codeStyles/
/.idea/codeStyles/*
!/.idea/codeStyles/Project.xml
!/.idea/codeStyles/codeStyleConfig.xml

# Logs / temp
*.log
*.tmp
**/tmp/*
**/temp/*
!**/tmp/.keep
!**/tmp/.gitkeep
!**/temp/.keep
!**/temp/.gitkeep

# AI coding agents (personal, local-only files)
.claude
/.agents/
CLAUDE.local.md
/AGENTS.override.md
# Spec Kit: everything is local except the constitution
# (covers feature.json, extensions/*/local-config.yml, extensions/.cache|.backup)
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md

# Skill outputs (automatically archived)
/.zenuml/
